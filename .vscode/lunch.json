{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "args": ["-test.v"],
            "showLog": true,
            "cwd": "${workspaceFolder}",
            "asRoot": true,
            "env": {
                "PATH": "/usr/local/go/bin:\"$PATH\""
            },
            "console": "integratedTerminal"
        }
    ]
}
